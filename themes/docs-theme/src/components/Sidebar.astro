---
import type { SidebarSection } from '../types';

export interface Props {
  sections: SidebarSection[];
}

const { sections } = Astro.props;
---

<aside class="hidden lg:block w-64 border-r border-border bg-background sticky top-0 h-screen overflow-y-auto">
  <div class="p-6">
    <nav class="space-y-6">
      {sections.map((section) => (
        <div>
          <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">
            {section.title}
          </h3>
          <ul class="space-y-1">
            {section.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block px-2 py-1 text-sm rounded-md transition-colors',
                    item.active
                      ? 'bg-primary text-primary-foreground font-medium'
                      : 'text-muted-foreground hover:text-foreground hover:bg-accent',
                  ]}
                >
                  {item.label}
                  {item.badge && (
                    <span class="ml-2 text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-muted text-muted-foreground">
                      {item.badge}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</aside>
