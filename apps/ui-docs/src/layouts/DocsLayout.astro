---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "@saastro-io/docs-theme/components/Sidebar.astro";
import type { SidebarSection } from "@saastro-io/docs-theme";
import { getCollection } from "astro:content";
import { makePermalinks } from "@saastro-io/shell/urls/permalinks";
import { blocks, categories } from "@/lib/catalog";

export interface Props {
  metadata?: any;
  showAnnouncement?: boolean;
}

const { getPermalink } = await makePermalinks(Astro);
const docs = await getCollection("docs");
const currentPath = Astro.url.pathname;

const getDocSlug = (id: string) => id.replace(/\/index$/, "").replace(/\/$/, "");

const gettingStartedDocs = [...docs]
  .filter((d) => d.data.published !== false && d.data.section === "getting-started")
  .sort((a, b) => a.data.order - b.data.order);

const sidebar: SidebarSection[] = [
  {
    title: "Getting Started",
    items: gettingStartedDocs.map((doc) => {
      const docPath = getPermalink(`/docs/${getDocSlug(doc.id)}`);
      return {
        label: doc.data.title,
        href: docPath,
        active: currentPath === docPath || currentPath === docPath + "/",
      };
    }),
  },
  ...categories.map((cat) => ({
    title: cat,
    items: blocks
      .filter((b) => b.category === cat)
      .map((block) => {
        const blockPath = `/blocks/${block.name}`;
        return {
          label: block.title,
          href: blockPath,
          active: currentPath === blockPath || currentPath === blockPath + "/",
        };
      }),
  })),
];
---

<BaseLayout {...Astro.props}>
  <div class="flex min-h-screen">
    <Sidebar sections={sidebar} />

    <main class="flex-1 min-w-0">
      <div class="container mx-auto px-4 py-8 lg:px-8 max-w-4xl">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>
