---
import "@/styles/global.css";
import ThemeBaseLayout from "@saastro-io/docs-theme/layouts/BaseLayout.astro";
import type { Props as ThemeProps } from "@saastro-io/docs-theme/layouts/BaseLayout.astro";
import SubNav from "@/components/SubNav.astro";

export type Props = ThemeProps;

const props = Astro.props;
---

<ThemeBaseLayout {...props}>
  <slot name="head" slot="head" />
  <slot name="announcement" slot="announcement" />
  <slot name="header" slot="header" />
  <SubNav currentPath={Astro.url.pathname} slot="after-header" />
  <slot name="footer" slot="footer" />
  <slot />
</ThemeBaseLayout>
