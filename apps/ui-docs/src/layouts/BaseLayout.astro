---
/**
 * Layout base del sitio. Envuelve el BaseLayout del tema VENDORIZADO
 * (src/theme/) y le añade el SubNav propio de ui.saastro.io.
 *
 * Antes esto envolvía `@saastro-io/docs-theme/layouts/BaseLayout.astro`, que a
 * su vez leía `settings.yaml` a través de `@saastro-io/shell`. Ahora los
 * valores del sitio (nombre, menú, idioma) se pasan explícitos aquí: una sola
 * fuente, visible, sin dos paquetes privados en medio.
 */
import '@/styles/global.css';
import ThemeBaseLayout from '@/theme/layouts/BaseLayout.astro';
import type { Props as ThemeProps } from '@/theme/layouts/BaseLayout.astro';
import SubNav from '@/components/SubNav.astro';

export type Props = ThemeProps;

const props = Astro.props;
---

<ThemeBaseLayout siteName="Saastro UI" homeUrl="/" language="en" {...props}>
  <Fragment slot="head">
    {/* Webfonts del design system. Van por <link> y no por `@import` en el CSS:
        saastro-ds.css se importa en segunda posición y un `@import url()` solo
        es válido al principio de la hoja — se descartaba sin avisar y el sitio
        se servía en Helvetica. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Space+Mono:ital,wght@0,400;0,700&display=swap"
    />
    <slot name="head" />
  </Fragment>
  <slot name="header" slot="header" />
  <SubNav currentPath={Astro.url.pathname} slot="after-header" />
  <slot name="footer" slot="footer" />
  <slot />
</ThemeBaseLayout>
