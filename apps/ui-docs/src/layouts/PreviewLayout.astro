---
/**
 * PreviewLayout — página de preview AISLADA, sin ningún chrome del sitio.
 * La usan /preview/[name] (iframe del detalle de bloque) y el script de
 * capturas (scripts/capture.mts). Tema por localStorage ANTES del paint,
 * compatible con el shell del sitio padre (misma clave `theme`), y sincronía
 * en vivo vía evento `storage` cuando vive dentro del iframe (mismo origen).
 */
import '@/styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title} — preview</title>
    <!-- Mismas webfonts que el resto del sitio: esta página alimenta el iframe
         de /blocks/[name] Y las capturas de scripts/capture.mts, así que si no
         se cargan aquí, los previews y los PNG salen en Helvetica. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Space+Mono:ital,wght@0,400;0,700&display=swap"
    />
    <script is:inline>
      const t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches))
        document.documentElement.classList.add('dark');
      addEventListener('storage', (e) => {
        if (e.key === 'theme')
          document.documentElement.classList.toggle('dark', e.newValue === 'dark');
      });
    </script>
  </head>
  <body class="bg-background text-foreground">
    <!-- data-capture-target: scripts/capture.mts fotografía ESTE elemento, no la
         página. Con fullPage los bloques más cortos que el viewport salían con
         una banda muerta debajo, que es lo que se veía en las tarjetas. -->
    <div data-capture-target>
      <slot />
    </div>
  </body>
</html>
