---
/**
 * Tarjeta de galería con la captura commiteada del bloque (light+dark vía
 * clases: sin JS, el tema lo decide la clase .dark del html). Carga
 * instantánea — antes cada tarjeta hidrataba el bloque entero con
 * client:visible.
 */
import type { CatalogItem } from '@/lib/catalog';

interface Props {
  block: CatalogItem;
}
const { block } = Astro.props;
---

<div class="block-card overflow-hidden rounded-xl border bg-card" data-category={block.category}>
  <a href={`/blocks/${block.name}`} class="group block">
    <!-- Altura fija + object-contain: cada bloque tiene su proporción natural
         (de 1.28 a 5.14) porque la captura recorta al elemento. En un catálogo
         interesa ver la pieza ENTERA, no un recorte, así que se encaja
         completa en un marco uniforme. -->
    <div class="relative flex h-52 items-center justify-center overflow-hidden border-b bg-muted/20 p-3 sm:h-60">
      <img
        src={`/previews/${block.name}-light.png`}
        alt={`${block.title} preview`}
        loading="lazy"
        class="h-full w-full rounded-sm object-contain transition-transform duration-300 group-hover:scale-[1.02] dark:hidden"
      />
      <img
        src={`/previews/${block.name}-dark.png`}
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="hidden h-full w-full rounded-sm object-contain transition-transform duration-300 group-hover:scale-[1.02] dark:block"
      />
    </div>
    <div class="flex items-center justify-between px-5 py-4">
      <div>
        <h2 class="font-semibold">{block.title}</h2>
        <p class="mt-0.5 line-clamp-1 text-sm text-muted-foreground">{block.description}</p>
      </div>
      <span class="ml-4 shrink-0 rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">
        {block.category}
      </span>
    </div>
  </a>
</div>
