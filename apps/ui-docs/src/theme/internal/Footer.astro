---
/**
 * Footer.astro — pie mínimo del sitio.
 *
 * Tema VENDORIZADO (ver theme/README.md). Sustituye a
 * `@saastro-io/shell/components/footer/Footer.astro`: línea de copyright y poco
 * más. Sin redes ni grupos de enlaces — eso es de un sitio de marketing.
 *
 * Diferencia respecto al original de saastro-relay: `showAttribution` viene
 * DESACTIVADO por defecto (el original lo traía a true y BaseLayout no lo
 * reenviaba, así que estampaba "Generated by saastro-relay" sin forma de
 * quitarlo).
 */
export interface Props {
  siteName?: string
  /** Override the auto-generated copyright line. */
  copyright?: string
  /** Atribución a saastro-relay. Desactivada por defecto. */
  showAttribution?: boolean
}

const {
  siteName = 'Saastro',
  copyright,
  showAttribution = false,
} = Astro.props as Props

const year = new Date().getFullYear()
const text = copyright ?? `© ${year} ${siteName}. All rights reserved.`
---

<footer class="border-t bg-background text-muted-foreground">
  <div class="container mx-auto px-4 md:px-6 flex flex-col md:flex-row items-center justify-between gap-2 py-4 text-xs">
    <p>{text}</p>
    {showAttribution && (
      <p class="text-muted-foreground/70">
        Generated by{' '}
        <a
          href="https://github.com/jcenlo/saastro-relay"
          class="hover:text-foreground transition-colors"
          rel="noopener"
        >
          saastro-relay
        </a>
      </p>
    )}
  </div>
</footer>
