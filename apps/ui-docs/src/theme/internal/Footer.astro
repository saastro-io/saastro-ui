---
/**
 * Footer.astro — pie mínimo del sitio.
 *
 * Tema VENDORIZADO (ver theme/README.md). Sustituye a
 * `@saastro-io/shell/components/footer/Footer.astro`: línea de copyright y poco
 * más. Sin redes ni grupos de enlaces — eso es de un sitio de marketing.
 */
export interface Props {
  siteName?: string
  /** Override the auto-generated copyright line. */
  copyright?: string
}

const { siteName = 'Saastro', copyright } = Astro.props as Props

const year = new Date().getFullYear()
const text = copyright ?? `© ${year} ${siteName}. All rights reserved.`
---

<footer class="border-t bg-background text-muted-foreground">
  <div class="container mx-auto px-4 md:px-6 flex flex-col md:flex-row items-center justify-between gap-2 py-4 text-xs">
    <p>{text}</p>
  </div>
</footer>
