---
/**
 * Header.astro — minimal documentation header.
 *
 * Self-contained replacement for `@saastro-io/shell/components/navBar/Header.astro`.
 * Drops marketing concerns (NavigationMenu, MobileMenu sheet, PlatformSwitcher,
 * RSS, contact button, platform branding). Keeps:
 *  - site title (linked to home)
 *  - optional flat top-level menu (no nested dropdowns)
 *  - sidebar toggle button (visible at <lg breakpoints)
 *  - inline theme toggle
 *
 * No dependencies beyond Astro itself.
 */
import type { MenuItem } from './types'

export interface Props {
  /** Site title shown next to the home link. */
  siteName?: string
  /** Home URL. */
  homeUrl?: string
  /** Top-level navigation links. Nested `items` are ignored — keep it flat. */
  menu?: MenuItem[]
  /** Current path for active link highlight. */
  currentPath?: string
  /** Show inline theme toggle. */
  showToggleTheme?: boolean
  /** Show sidebar toggle button (hidden on lg+). */
  showSidebarToggle?: boolean
}

const {
  siteName = 'Docs',
  homeUrl = '/',
  menu = [],
  currentPath,
  showToggleTheme = true,
  showSidebarToggle = false,
} = Astro.props as Props
---

<header class="sticky top-0 z-50 h-14 px-4 border-b bg-background/80 backdrop-blur-md flex items-center gap-4">
  <div class="flex items-center gap-3 flex-1 min-w-0">
    {showSidebarToggle && (
      <button
        type="button"
        aria-label="Toggle sidebar"
        data-docs-sidebar-toggle
        class="lg:hidden inline-flex items-center justify-center h-8 w-8 rounded-md hover:bg-accent"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    )}

    <a
      href={homeUrl}
      class="font-semibold text-foreground hover:text-primary transition-colors truncate"
    >
      {siteName}
    </a>
  </div>

  {menu.length > 0 && (
    <nav class="hidden md:flex items-center gap-4 text-sm" aria-label="Main">
      {menu.map((item) => {
        const isActive = currentPath && item.url && currentPath.startsWith(item.url)
        return (
          <a
            href={item.url}
            class:list={[
              'transition-colors',
              isActive
                ? 'text-foreground font-medium'
                : 'text-muted-foreground hover:text-foreground',
            ]}
          >
            {item.title}
          </a>
        )
      })}
    </nav>
  )}

  {showToggleTheme && (
    <button
      type="button"
      aria-label="Toggle theme"
      data-docs-theme-toggle
      class="inline-flex items-center justify-center h-8 w-8 rounded-md hover:bg-accent"
    >
      <svg
        class="hidden dark:block"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
      <svg
        class="block dark:hidden"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
  )}
</header>

<script>
  // Inline theme toggle handler — relies on window.applyTheme exposed by ApplyColorMode.
  const btn = document.querySelector<HTMLButtonElement>('[data-docs-theme-toggle]')
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark')
    // @ts-expect-error - applyTheme is defined globally by ApplyColorMode.astro
    window.applyTheme?.(isDark ? 'light' : 'dark')
  })
</script>
