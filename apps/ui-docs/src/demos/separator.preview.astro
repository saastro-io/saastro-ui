<div class="flex min-h-[420px] flex-col items-center justify-center gap-5 p-8">
  <div class="w-full max-w-sm">
    <p class="text-sm font-medium">Horizontal</p>
    <Separator className="my-4" />
    <div class="flex h-8 items-center gap-4 text-sm">
      <span>Uno</span>
      <Separator orientation="vertical" />
      <span>Dos</span>
      <Separator orientation="vertical" />
      <span>Tres</span>
    </div>
  </div>
</div>
