---
// Import LITERAL + client:load: la hidratación exige que el compiler vea el
// import; un componente dinámico de import.meta.glob no emite
// client:component-path y revienta en runtime.
import { DropdownMenuDemo } from './dropdown-menu.demo';
---

<div class="flex min-h-[420px] items-start justify-center p-8 pt-16">
  <DropdownMenuDemo client:load />
</div>
