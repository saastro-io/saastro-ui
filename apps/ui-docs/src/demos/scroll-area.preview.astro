---
// Demo de preview. 
import { ScrollArea } from '@ui-registry/scroll-area';
import { Separator } from '@ui-registry/separator';
---

<div class="flex min-h-[420px] flex-col items-center justify-center gap-5 p-8">
  <ScrollArea className="h-64 w-full max-w-xs rounded-md border p-4">
    <div class="space-y-3 text-sm">
      {Array.from({ length: 20 }, (_, i) => (
        <div>
          <p>Elemento {i + 1}</p>
          <Separator className="mt-3" />
        </div>
      ))}
    </div>
  </ScrollArea>
</div>
