---
// Showcase de button-pro. Sin client:* — no tiene estado; efectos por CSS.
import { ButtonPro } from '@ui-registry/button-pro';
---

<div class="flex min-h-[400px] flex-wrap items-center justify-center gap-4 p-12">
  <ButtonPro variant="default">Default</ButtonPro>
  <ButtonPro variant="destructive">Destructive</ButtonPro>
  <ButtonPro variant="outline">Outline</ButtonPro>
  <ButtonPro variant="secondary">Secondary</ButtonPro>
  <ButtonPro variant="ghost">Ghost</ButtonPro>
  <ButtonPro variant="link">Link</ButtonPro>
  <ButtonPro variant="default" effect="shine">Shine</ButtonPro>
  <ButtonPro variant="default" effect="gooeyRight">Gooey</ButtonPro>
  <ButtonPro variant="link" effect="hoverUnderline">Hover underline</ButtonPro>
</div>
