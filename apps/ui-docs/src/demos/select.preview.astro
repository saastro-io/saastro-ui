// import; un componente dinámico de import.meta.glob no emite
// client:component-path y revienta en runtime.
import { SelectDemo } from './select.demo';
---

<div class="flex min-h-[400px] items-center justify-center p-12">
  <SelectDemo client:load />
</div>
