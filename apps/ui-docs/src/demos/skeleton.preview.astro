---
// Markup puro: sin isla. Un esqueleto de tarjeta, que es donde de verdad se ve
// para qué sirve —marcar la forma de lo que viene, no un spinner centrado—.
import { Skeleton } from '@ui-registry/skeleton';
---

<div class="flex min-h-[240px] items-center justify-center p-8">
  <div class="w-80 space-y-3 rounded-xl border bg-card p-4">
    <div class="flex items-center gap-3">
      <Skeleton class="size-10 rounded-full" />
      <div class="flex-1 space-y-2">
        <Skeleton class="h-3.5 w-2/3" />
        <Skeleton class="h-3 w-1/3" />
      </div>
    </div>
    <Skeleton class="h-24 w-full" />
  </div>
</div>
