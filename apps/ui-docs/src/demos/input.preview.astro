---
// Demo de preview. 
import { Input } from '@ui-registry/input';
import { Label } from '@ui-registry/label';
---

<div class="flex min-h-[420px] flex-col items-center justify-center gap-5 p-8">
  <div class="w-full max-w-sm space-y-4">
    <div class="space-y-2">
      <Label htmlFor="email">Email</Label>
      <Input id="email" type="email" placeholder="tucorreo@email.com" />
    </div>
    <Input placeholder="Deshabilitado" disabled />
    <Input placeholder="Inválido" aria-invalid="true" />
  </div>
</div>
