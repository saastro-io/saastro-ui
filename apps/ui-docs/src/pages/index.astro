---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { blocks, blockItems, categories } from '@/lib/catalog';
import BlockCard from '@/components/BlockCard.astro';
import InstallCommand from '@/components/InstallCommand.astro';

const metadata = {
  title: 'Saastro Blocks — Landing page blocks for Astro',
  description:
    'Zero-JS Astro blocks and interactive React blocks. Install with the shadcn CLI into any Astro or React project.',
  ignoreTitleTemplate: true,
};

const astroBlocks = blocks.filter((b) => b.ext === 'astro').length;
const featured = blockItems.slice(0, 6);
---

<BaseLayout metadata={metadata} showAnnouncement={false}>
  <!-- ================= Hero ================= -->
  <!-- Dot-grid + crosshairs en las esquinas: los dos movimientos focales del
       sistema. La rejilla se desvanece hacia abajo con una máscara para que no
       compita con el contenido. -->
  <section class="relative w-full overflow-hidden border-b px-6 py-24 md:py-32">
    <div
      class="dot-grid pointer-events-none absolute inset-0 opacity-60 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,black,transparent)]"
    >
    </div>
    <div class="relative mx-auto max-w-3xl text-center">
      <p class="eyebrow mb-6">Registry</p>
      <h1
        class="text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.02] font-medium tracking-[-0.02em] text-balance"
      >
        Landing blocks for Astro.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground text-pretty">
        {astroBlocks} of {blocks.length} blocks ship zero JavaScript and zero dependencies — they install
        into an Astro project without React. Interactive ones come as React on Base UI.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/blocks"
          class="machined press inline-flex h-11 items-center justify-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Browse blocks
        </a>
        <a
          href="/docs/introduction"
          class="press inline-flex h-11 items-center justify-center rounded-lg border bg-card px-6 text-sm font-medium shadow-xs transition-colors hover:bg-muted"
        >
          Read the docs
        </a>
      </div>
      <div class="mx-auto mt-10 max-w-lg text-left">
        <InstallCommand name="hero-01" />
      </div>
    </div>

    <!-- Crosshairs hairline en las cuatro esquinas del contenedor focal -->
    <span class="crosshair top-8 left-8"></span>
    <span class="crosshair top-8 right-8"></span>
    <span class="crosshair bottom-8 left-8"></span>
    <span class="crosshair bottom-8 right-8"></span>
  </section>

  <!-- ================= Métricas ================= -->
  <!-- Numerales grotesk, tight tracking: el "grotesk numerals" del sistema. -->
  <section class="w-full border-b px-6 py-14">
    <div class="mx-auto grid max-w-5xl grid-cols-2 gap-8 lg:grid-cols-4">
      {
        [
          { value: blocks.length, label: 'Blocks in the registry' },
          { value: astroBlocks, label: 'Zero-JS Astro blocks' },
          { value: categories.length, label: 'Categories' },
          { value: '0', label: 'Runtime dependencies' },
        ].map((stat, i) => (
          <div class:list={['text-center', i > 0 && 'lg:border-l lg:border-border']}>
            <p class="text-4xl font-medium tracking-[-0.02em] tabular-nums sm:text-5xl">
              {stat.value}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= Bloques destacados ================= -->
  <section class="w-full px-6 py-20 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3">Blocks</p>
          <h2 class="text-3xl font-medium tracking-[-0.02em] sm:text-4xl">
            Copy, paste, and ship.
          </h2>
        </div>
        <a
          href="/blocks"
          class="text-sm text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
        >
          All {blockItems.length} blocks →
        </a>
      </div>

      <div class="mb-10 flex flex-wrap gap-2">
        {
          categories.map((cat) => (
            <a
              href={`/blocks?category=${encodeURIComponent(cat)}`}
              class="rounded-full border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            >
              {cat}
              <span class="ml-1.5 font-mono text-xs opacity-60">
                {blocks.filter((b) => b.category === cat).length}
              </span>
            </a>
          ))
        }
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {featured.map((block) => <BlockCard block={block} />)}
      </div>
    </div>
  </section>

  <!-- ================= Cómo funciona ================= -->
  <section class="w-full border-t px-6 py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <p class="eyebrow mb-3">How it works</p>
      <h2 class="mb-12 text-3xl font-medium tracking-[-0.02em] sm:text-4xl">
        Three steps, no build step.
      </h2>
      <div class="grid gap-px overflow-hidden rounded-xl border bg-border sm:grid-cols-3">
        {
          [
            {
              n: '01',
              title: 'Point at the registry',
              body: 'Add @saastro to the registries map in your components.json.',
            },
            {
              n: '02',
              title: 'Install a block',
              body: 'The CLI copies the source into your project and pulls any primitive it needs.',
            },
            {
              n: '03',
              title: 'Make it yours',
              body: 'It is your code now — edit the markup, swap the tokens, ship it.',
            },
          ].map((step) => (
            <div class="bg-card p-6">
              <p class="font-mono text-xs tracking-[0.08em] text-muted-foreground">{step.n}</p>
              <h3 class="mt-4 font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 overflow-hidden rounded-xl border">
        <div class="border-b bg-muted/40 px-4 py-2.5">
          <span class="font-mono text-xs tracking-[0.08em] text-muted-foreground"
            >COMPONENTS.JSON</span
          >
        </div>
        <pre class="overflow-x-auto bg-card p-4 text-sm"><code class="font-mono">{`{
  "registries": {
    "@saastro": "https://ui.saastro.io/r/{name}.json"
  }
}`}</code></pre>
      </div>
    </div>
  </section>
</BaseLayout>
