---
import BaseLayout from '@/layouts/BaseLayout.astro';

const metadata = {
  title: 'Página no encontrada — Saastro UI',
  description: 'La página que buscas no existe o ha cambiado de sitio.',
};
---

<BaseLayout metadata={metadata} showAnnouncement={false}>
  <section class="w-full px-6 py-24 md:py-32">
    <div class="mx-auto max-w-xl text-center">
      <p class="mb-4 text-sm font-medium text-muted-foreground">404</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Esta página no existe</h1>
      <p class="mt-4 text-muted-foreground">
        Puede que el enlace esté roto o que el contenido se haya movido.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="/" class="text-sm font-medium underline underline-offset-4">Volver al inicio</a>
        <a href="/blocks" class="text-sm font-medium underline underline-offset-4">Ver los bloques</a>
      </div>
    </div>
  </section>
</BaseLayout>
