---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { uiItems as items, uiCategories as categories } from "@/lib/catalog";

const metadata = {
  title: "UI Primitives — Saastro",
  description: "Enhanced UI components built on shadcn/ui and Radix primitives. Button Pro, and more coming soon.",
};
---

<BaseLayout metadata={metadata} showAnnouncement={false}>
  <div class="w-full px-6 py-12">
    <div class="mx-auto max-w-6xl">
      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">UI Primitives</h1>
        <p class="mt-2 text-muted-foreground">
          Enhanced components built on shadcn/ui and Radix. Install via the shadcn CLI.
        </p>
      </div>

      {categories.length > 1 && (
        <div id="ui-category-filter" class="mb-10 flex flex-wrap gap-2">
          <a
            href="/ui"
            data-category="All"
            class="ui-filter-btn active rounded-full border px-3 py-1.5 text-sm font-medium transition-colors border-primary bg-primary text-primary-foreground"
          >
            All
          </a>
          {categories.map(cat => (
            <a
              href={`/ui?category=${encodeURIComponent(cat)}`}
              data-category={cat}
              class="ui-filter-btn rounded-full border px-3 py-1.5 text-sm font-medium transition-colors text-muted-foreground hover:bg-accent hover:text-foreground"
            >
              {cat}
            </a>
          ))}
        </div>
      )}

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map(item => (
          <a
            href={`/blocks/${item.name}`}
            data-category={item.category}
            class="ui-card group overflow-hidden rounded-xl border bg-card transition-colors hover:bg-accent/50"
          >
            <div class="relative aspect-[1440/900] overflow-hidden border-b bg-background">
              <img src={`/previews/${item.name}-light.png`} alt={`${item.title} preview`} width="1440" height="900" loading="lazy" class="size-full object-cover object-top dark:hidden" />
              <img src={`/previews/${item.name}-dark.png`} alt="" aria-hidden="true" width="1440" height="900" loading="lazy" class="hidden size-full object-cover object-top dark:block" />
            </div>
            <div class="p-6 pt-4">
            <h2 class="font-semibold group-hover:text-foreground">{item.title}</h2>
            <p class="mt-1.5 text-sm text-muted-foreground">{item.description}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {item.dependencies.map(dep => (
                <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">{dep}</span>
              ))}
            </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const active = "border-primary bg-primary text-primary-foreground";
  const inactive = "text-muted-foreground hover:bg-accent hover:text-foreground";

  function applyFilter(category: string) {
    document.querySelectorAll<HTMLElement>(".ui-card").forEach(card => {
      card.style.display = category === "All" || card.dataset.category === category ? "" : "none";
    });
    document.querySelectorAll<HTMLAnchorElement>(".ui-filter-btn").forEach(btn => {
      const isActive = btn.dataset.category === category;
      active.split(" ").forEach(c => btn.classList.toggle(c, isActive));
      inactive.split(" ").forEach(c => btn.classList.toggle(c, !isActive));
    });
  }

  const cat = new URL(window.location.href).searchParams.get("category") || "All";
  applyFilter(cat);

  document.getElementById("ui-category-filter")?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLAnchorElement>(".ui-filter-btn");
    if (!btn) return;
    e.preventDefault();
    const c = btn.dataset.category || "All";
    applyFilter(c);
    history.replaceState(null, "", c === "All" ? "/ui" : `/ui?category=${encodeURIComponent(c)}`);
  });
</script>
