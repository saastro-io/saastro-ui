---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { blocks } from '@/lib/catalog';
import CodeBlock from '@/components/CodeBlock.astro';
import InstallCommand from '@/components/InstallCommand.astro';
// Read all block and UI sources at build time via Vite's raw import
const blockSources = {
  ...import.meta.glob(
    '../../../../../packages/ui-registry/registry/default/blocks/*.{tsx,astro}',
    { query: '?raw', import: 'default', eager: true },
  ),
  ...import.meta.glob(
    '../../../../../packages/ui-registry/registry/default/ui/*.{tsx,astro}',
    { query: '?raw', import: 'default', eager: true },
  ),
} as Record<string, string>;

export function getStaticPaths() {
  return blocks.map((block) => ({
    params: { name: block.name },
    props: { block },
  }));
}

const { block } = Astro.props;

// Find source code from the glob results
const sourceKey = Object.keys(blockSources).find((k) => k.endsWith(`/${block.name}.${block.ext}`));
const sourceCode = sourceKey ? blockSources[sourceKey] : '// Source not found';

const metadata = {
  title: `${block.title} — Saastro Blocks`,
  description: block.description,
};
---

<BaseLayout metadata={metadata} showAnnouncement={false}>
  <div class="w-full px-6 py-12">
    <div class="mx-auto max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-sm text-muted-foreground">
        <a href={block.section === 'ui' ? '/ui' : '/blocks'} class="hover:text-foreground">
          {block.section === 'ui' ? 'UI' : 'Blocks'}
        </a>
        <span class="mx-2">/</span>
        <span>{block.title}</span>
      </nav>

      <!-- Header -->
      <div class="mb-8 flex items-start justify-between">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">{block.title}</h1>
          <p class="mt-2 text-muted-foreground">{block.description}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="rounded-md bg-muted px-2 py-1 text-xs font-medium text-muted-foreground">
              {block.category}
            </span>
            {
              block.dependencies.map((dep: string) => (
                <span class="rounded bg-primary/5 px-2 py-1 text-xs text-primary/70">{dep}</span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Install command -->
      <div class="mb-8">
        <h2 class="mb-3 text-sm font-semibold text-muted-foreground uppercase tracking-wider">
          Installation
        </h2>
        <InstallCommand name={block.name} />
      </div>

      <!-- Preview -->
      <div class="mb-8">
        <h2 class="mb-3 text-sm font-semibold text-muted-foreground uppercase tracking-wider">
          Preview
        </h2>
        <!-- Desktop: iframe VIVO de /preview/<name> (interactivo, tema sincronizado
             por localStorage al cargar y por evento storage en vivo). Móvil: la
             captura commiteada — un iframe de 1440px no aporta en pantalla estrecha. -->
        <div class="preview-frame hidden overflow-hidden rounded-xl border bg-background md:block">
          <div class="flex items-center justify-end gap-1 border-b bg-muted/30 px-3 py-2">
            <button type="button" data-width="100%" class="width-btn rounded border bg-background px-2 py-0.5 text-xs text-foreground">Desktop</button>
            <button type="button" data-width="768px" class="width-btn rounded border px-2 py-0.5 text-xs text-muted-foreground hover:text-foreground">Tablet</button>
            <button type="button" data-width="390px" class="width-btn rounded border px-2 py-0.5 text-xs text-muted-foreground hover:text-foreground">Mobile</button>
          </div>
          <div class="flex justify-center bg-muted/10">
            <iframe
              src={`/preview/${block.name}`}
              title={`${block.title} preview`}
              loading="lazy"
              class="w-full border-0 transition-[width] duration-300"
              style={`height: ${block.iframeHeight}`}></iframe>
          </div>
        </div>
        <div class="overflow-hidden rounded-xl border bg-background md:hidden">
          <img
            src={`/previews/${block.name}-light.png`}
            alt={`${block.title} preview`}
            width="1440"
            height="900"
            class="w-full dark:hidden"
          />
          <img
            src={`/previews/${block.name}-dark.png`}
            alt=""
            aria-hidden="true"
            width="1440"
            height="900"
            class="hidden w-full dark:block"
          />
        </div>
      </div>

      <!-- Source code -->
      <div class="mb-8">
        <h2 class="mb-3 text-sm font-semibold text-muted-foreground uppercase tracking-wider">
          Source Code
        </h2>
        <CodeBlock code={sourceCode} lang={block.ext} />
      </div>

      <!-- Registry config -->
      <div class="mb-8">
        <h2 class="mb-3 text-sm font-semibold text-muted-foreground uppercase tracking-wider">
          Registry Setup
        </h2>
        <p class="mb-3 text-sm text-muted-foreground">
          Add the Saastro registry to your <code class="rounded bg-muted px-1">components.json</code
          >:
        </p>
        <pre
          class="overflow-x-auto rounded-lg border bg-muted/50 p-4 text-sm"><code>{`{
  "registries": {
    "@saastro": "https://ui.saastro.io/r/{name}.json"
  }
}`}</code></pre>
      </div>

      <!-- Navigation -->
      <div class="flex items-center justify-between border-t pt-6">
        {
          (() => {
            const idx = blocks.findIndex((b) => b.name === block.name);
            const prev = idx > 0 ? blocks[idx - 1] : null;
            const next = idx < blocks.length - 1 ? blocks[idx + 1] : null;
            return (
              <>
                {prev ? (
                  <a
                    href={`/blocks/${prev.name}`}
                    class="text-sm text-muted-foreground hover:text-foreground"
                  >
                    &larr; {prev.title}
                  </a>
                ) : (
                  <span />
                )}
                {next ? (
                  <a
                    href={`/blocks/${next.name}`}
                    class="text-sm text-muted-foreground hover:text-foreground"
                  >
                    {next.title} &rarr;
                  </a>
                ) : (
                  <span />
                )}
              </>
            );
          })()
        }
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.preview-frame').forEach((frame) => {
    const iframe = frame.querySelector('iframe');
    frame.querySelectorAll<HTMLButtonElement>('.width-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (iframe) iframe.style.width = btn.dataset.width ?? '100%';
        frame.querySelectorAll('.width-btn').forEach((b) => {
          b.classList.toggle('bg-background', b === btn);
          b.classList.toggle('text-foreground', b === btn);
          b.classList.toggle('text-muted-foreground', b !== btn);
        });
      });
    });
  });
</script>
