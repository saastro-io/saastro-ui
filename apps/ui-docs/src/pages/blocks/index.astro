---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { blockItems as blocks, blockCategories as categories } from "@/data/blocks";
import { BlockRenderer } from "@/components/block-renderer";

const metadata = {
  title: "All Blocks — Saastro",
  description: "Browse all available landing page blocks. Hero, features, pricing, testimonials, and more.",
};
---

<BaseLayout metadata={metadata} showAnnouncement={false}>
  <div class="w-full px-6 py-12">
    <div class="mx-auto max-w-6xl">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blocks</h1>
        <p class="mt-2 text-muted-foreground">
          Browse all {blocks.length} blocks. Click any block to see the full preview, source code, and install command.
        </p>
      </div>

      <!-- Category filter -->
      <div id="category-filter" class="mb-10 flex flex-wrap gap-2">
        <a
          href="/blocks"
          data-category="All"
          class="filter-btn active rounded-full border px-3 py-1.5 text-sm font-medium transition-colors border-primary bg-primary text-primary-foreground"
        >
          All
        </a>
        {categories.map(cat => (
          <a
            href={`/blocks?category=${encodeURIComponent(cat)}`}
            data-category={cat}
            class="filter-btn rounded-full border px-3 py-1.5 text-sm font-medium transition-colors text-muted-foreground hover:bg-accent hover:text-foreground"
          >
            {cat}
          </a>
        ))}
      </div>

      <!-- Block cards -->
      <div id="block-grid" class="grid gap-8">
        {blocks.map(block => (
          <div class="block-card rounded-xl border bg-card overflow-hidden" data-category={block.category}>
            <!-- Block header -->
            <div class="flex items-center justify-between border-b px-6 py-4">
              <div class="flex items-center gap-3">
                <h2 class="font-semibold">{block.title}</h2>
                <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">{block.category}</span>
              </div>
              <a
                href={`/blocks/${block.name}`}
                class="rounded-md border bg-background px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
              >
                View &rarr;
              </a>
            </div>
            <!-- Block preview -->
            <div class="bg-background">
              <BlockRenderer name={block.name} client:visible />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const active = "border-primary bg-primary text-primary-foreground";
  const inactive = "text-muted-foreground hover:bg-accent hover:text-foreground";

  function applyFilter(category: string) {
    document.querySelectorAll<HTMLElement>(".block-card").forEach(card => {
      card.style.display = category === "All" || card.dataset.category === category ? "" : "none";
    });
    document.querySelectorAll<HTMLAnchorElement>(".filter-btn").forEach(btn => {
      const isActive = btn.dataset.category === category;
      active.split(" ").forEach(c => btn.classList.toggle(c, isActive));
      inactive.split(" ").forEach(c => btn.classList.toggle(c, !isActive));
    });
  }

  // Read initial category from URL
  const cat = new URL(window.location.href).searchParams.get("category") || "All";
  applyFilter(cat);

  // Handle clicks without full page reload
  document.getElementById("category-filter")?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLAnchorElement>(".filter-btn");
    if (!btn) return;
    e.preventDefault();
    const c = btn.dataset.category || "All";
    applyFilter(c);
    history.replaceState(null, "", c === "All" ? "/blocks" : `/blocks?category=${encodeURIComponent(c)}`);
  });
</script>
