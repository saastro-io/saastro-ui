---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { uiItems as items, uiCategories as categories } from "@/data/blocks";

const metadata = {
  title: "UI Primitives — Saastro",
  description: "Enhanced UI components built on shadcn/ui and Radix primitives. Button Pro, and more coming soon.",
};

const url = new URL(Astro.request.url);
const activeCategory = url.searchParams.get("category") || "All";
const filteredItems = activeCategory === "All" ? items : items.filter(b => b.category === activeCategory);
---

<BaseLayout metadata={metadata} showAnnouncement={false}>
  <div class="w-full px-6 py-12">
    <div class="mx-auto max-w-6xl">
      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">UI Primitives</h1>
        <p class="mt-2 text-muted-foreground">
          Enhanced components built on shadcn/ui and Radix. Install via the shadcn CLI.
        </p>
      </div>

      {categories.length > 1 && (
        <div class="mb-10 flex flex-wrap gap-2">
          <a
            href="/ui"
            class:list={[
              "rounded-full border px-3 py-1.5 text-sm font-medium transition-colors",
              activeCategory === "All"
                ? "border-primary bg-primary text-primary-foreground"
                : "text-muted-foreground hover:bg-accent hover:text-foreground",
            ]}
          >
            All
          </a>
          {categories.map(cat => (
            <a
              href={`/ui?category=${encodeURIComponent(cat)}`}
              class:list={[
                "rounded-full border px-3 py-1.5 text-sm font-medium transition-colors",
                activeCategory === cat
                  ? "border-primary bg-primary text-primary-foreground"
                  : "text-muted-foreground hover:bg-accent hover:text-foreground",
              ]}
            >
              {cat}
            </a>
          ))}
        </div>
      )}

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {filteredItems.map(item => (
          <a
            href={`/blocks/${item.name}`}
            class="group rounded-xl border bg-card p-6 transition-colors hover:bg-accent/50"
          >
            <h2 class="font-semibold group-hover:text-foreground">{item.title}</h2>
            <p class="mt-1.5 text-sm text-muted-foreground">{item.description}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {item.dependencies.map(dep => (
                <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">{dep}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
