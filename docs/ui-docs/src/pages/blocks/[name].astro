---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { blocks } from '@/data/blocks';
import { BlockRenderer } from '@/components/block-renderer';
import { CodeViewer, InstallCommand } from '@/components/code-viewer';
export const prerender = true;

// Read all block and UI sources at build time via Vite's raw import
const blockSources = {
  ...import.meta.glob(
    '../../../../../packages/ui-registry/registry/default/blocks/*.tsx',
    { query: '?raw', import: 'default', eager: true },
  ),
  ...import.meta.glob(
    '../../../../../packages/ui-registry/registry/default/ui/*.tsx',
    { query: '?raw', import: 'default', eager: true },
  ),
} as Record<string, string>;

export function getStaticPaths() {
  return blocks.map((block) => ({
    params: { name: block.name },
    props: { block },
  }));
}

const { block } = Astro.props;

// Find source code from the glob results
const sourceKey = Object.keys(blockSources).find((k) => k.endsWith(`/${block.name}.tsx`));
const sourceCode = sourceKey ? blockSources[sourceKey] : '// Source not found';

const metadata = {
  title: `${block.title} — Saastro Blocks`,
  description: block.description,
};
---

<BaseLayout metadata={metadata} showAnnouncement={false}>
  <div class="w-full px-6 py-12">
    <div class="mx-auto max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-sm text-muted-foreground">
        <a href={block.section === 'ui' ? '/ui' : '/blocks'} class="hover:text-foreground">
          {block.section === 'ui' ? 'UI' : 'Blocks'}
        </a>
        <span class="mx-2">/</span>
        <span>{block.title}</span>
      </nav>

      <!-- Header -->
      <div class="mb-8 flex items-start justify-between">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">{block.title}</h1>
          <p class="mt-2 text-muted-foreground">{block.description}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="rounded-md bg-muted px-2 py-1 text-xs font-medium text-muted-foreground">
              {block.category}
            </span>
            {
              block.dependencies.map((dep: string) => (
                <span class="rounded bg-primary/5 px-2 py-1 text-xs text-primary/70">{dep}</span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Install command -->
      <div class="mb-8">
        <h2 class="mb-3 text-sm font-semibold text-muted-foreground uppercase tracking-wider">
          Installation
        </h2>
        <InstallCommand name={block.name} client:load />
      </div>

      <!-- Preview -->
      <div class="mb-8">
        <h2 class="mb-3 text-sm font-semibold text-muted-foreground uppercase tracking-wider">
          Preview
        </h2>
        <div class="rounded-xl border overflow-hidden bg-background">
          <BlockRenderer name={block.name} client:visible />
        </div>
      </div>

      <!-- Source code -->
      <div class="mb-8">
        <h2 class="mb-3 text-sm font-semibold text-muted-foreground uppercase tracking-wider">
          Source Code
        </h2>
        <CodeViewer code={sourceCode} client:visible />
      </div>

      <!-- Registry config -->
      <div class="mb-8">
        <h2 class="mb-3 text-sm font-semibold text-muted-foreground uppercase tracking-wider">
          Registry Setup
        </h2>
        <p class="mb-3 text-sm text-muted-foreground">
          Add the Saastro registry to your <code class="rounded bg-muted px-1">components.json</code
          >:
        </p>
        <pre
          class="overflow-x-auto rounded-lg border bg-muted/50 p-4 text-sm"><code>{`{
  "registries": {
    "@saastro": "https://ui.saastro.io/r/{name}.json"
  }
}`}</code></pre>
      </div>

      <!-- Navigation -->
      <div class="flex items-center justify-between border-t pt-6">
        {
          (() => {
            const idx = blocks.findIndex((b) => b.name === block.name);
            const prev = idx > 0 ? blocks[idx - 1] : null;
            const next = idx < blocks.length - 1 ? blocks[idx + 1] : null;
            return (
              <>
                {prev ? (
                  <a
                    href={`/blocks/${prev.name}`}
                    class="text-sm text-muted-foreground hover:text-foreground"
                  >
                    &larr; {prev.title}
                  </a>
                ) : (
                  <span />
                )}
                {next ? (
                  <a
                    href={`/blocks/${next.name}`}
                    class="text-sm text-muted-foreground hover:text-foreground"
                  >
                    {next.title} &rarr;
                  </a>
                ) : (
                  <span />
                )}
              </>
            );
          })()
        }
      </div>
    </div>
  </div>
</BaseLayout>
